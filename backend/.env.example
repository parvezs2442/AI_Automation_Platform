# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_DB_NAME=automate_ai

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
# 64-character hex key for AES-256-GCM encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTOMATE_MCP_SECRET=your_mcp_jwt_secret_here
OAUTH_STATE_SECRET=your_oauth_state_secret_here

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Vision API
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key
GEMINI_VISION_MODEL=gemini-2.5-flash

# Google OAuth 2.0 (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# Instagram Graph API Integration
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
